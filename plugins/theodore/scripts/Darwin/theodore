#!/bin/sh
# Theodore's command in the plugin on macOS and Linux; the plugin's MCP entry runs it with `mcp`. .mcp.json names
# scripts/${OS:-unix}/theodore: Windows sets OS=Windows_NT, whose folder holds no extensionless file, so the host finds
# theodore.exe there (contract C0-2: an extensionless file beside the .exe would be taken, and fail); Darwin/ and Linux/
# hold this same script for a shell that sets OS to `uname -s`. It hands over to the native front built for this system
# (scripts/theodore-darwin, -linux-x64, -linux-arm64), which relays to Theodore's service (DESIGN.md §2); without one
# (a development tree) the skill's launcher serves, as before the front. Not bin/: claude.ai and Cowork refuse that.
case "$0" in */*) d=${0%/*} ;; *) d=. ;; esac
if [ -d /System/Library/CoreServices ]; then
  f=$d/../theodore-darwin
else
  case "$(uname -m 2>/dev/null)" in
    aarch64|arm64) f=$d/../theodore-linux-arm64 ;;
    *) f=$d/../theodore-linux-x64 ;;
  esac
fi
[ -f "$f" ] && [ -x "$f" ] && exec "$f" "$@"
exec sh "$d/../../skills/pptx/scripts/theodore" "$@"
