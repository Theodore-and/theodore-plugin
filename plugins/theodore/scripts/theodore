#!/bin/sh
# Theodore's command in the plugin; the plugin's MCP entry (.mcp.json, mcp.json) runs it with `mcp`. It hands over to
# the native front built for this system (theodore-darwin, theodore-linux-x64, theodore-linux-arm64 beside it), which
# relays to Theodore's service (DESIGN.md §2), passing its arguments on and adding none. Without a front for this
# system (a development tree, or Windows before its front is signed) the skill's launcher serves, as before the front.
# On Windows the host starts theodore.exe, else theodore.cmd, beside this file by their extension, never this script
# (contract C0-2, W2m and W4); Git Bash reaches the .exe through this script. Not in bin/: claude.ai and Cowork refuse
# a plugin with a top-level bin/.
case "$0" in */*) d=${0%/*} ;; *) d=. ;; esac
if [ -n "${MSYSTEM:-}" ] || [ "${OS:-}" = Windows_NT ]; then
  f=$d/theodore.exe
elif [ -d /System/Library/CoreServices ]; then
  f=$d/theodore-darwin
else
  case "$(uname -m 2>/dev/null)" in
    aarch64|arm64) f=$d/theodore-linux-arm64 ;;
    *) f=$d/theodore-linux-x64 ;;
  esac
fi
[ -f "$f" ] && [ -x "$f" ] && exec "$f" "$@"
exec sh "$d/../skills/pptx/scripts/theodore" "$@"
